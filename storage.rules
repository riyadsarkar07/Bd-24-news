rules_version = '2';

// BD24News Firebase Storage Rules
// Only the authenticated administrator may upload, overwrite or delete files.
// Everyone may read/download files so article images render publicly.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['8HTfUJOKIgZxbd9PuQAjr1HhuUa', '45StAH7WmbPt1l0tfJplfu2GSa33'];
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
