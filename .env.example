# =====================================================
# BD24News — Supabase configuration (Vercel environment)
# Copy these values from: Supabase Dashboard > Project Settings >
# API (Project URL + publishable key).
# =====================================================

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://pvqtsaiccfweearaltgo.supabase.co

# Supabase publishable (anon) key — never commit a service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Site URL used for metadata / canonical links
NEXT_PUBLIC_SITE_URL=https://bd24news.vercel.app

# Newsroom access is managed through Supabase profiles and roles.

# Optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# =====================================================
# Database migration note
# =====================================================
# New databases use the SQL files in supabase/migrations in timestamp order.
# BD NEWS 24 already has the newsroom_reliability migration (20261119124213).
# Earlier schema changes were applied outside migration tracking. Reconcile
# those versions against the live schema before using automated database pushes.

# Optional live broadcast. Use an HTTPS video URL supported by the browser.
NEXT_PUBLIC_LIVE_TV_URL=
# Server-only email delivery credentials. The sender must be verified with Resend.
RESEND_API_KEY=
NEWSLETTER_FROM=
