# =====================================================
# BD24News — Firebase configuration (Vercel environment)
# Copy these values from: Firebase console > Project settings >
# Your apps > Web app (the firebaseConfig snippet).
# =====================================================

# Firebase Web SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bd-news-24-5ec58.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bd-news-24-5ec58
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bd-news-24-5ec58.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=570904411140
NEXT_PUBLIC_FIREBASE_APP_ID=1:570904411140:web:5f2a2a11cb08005cf38951

# Site URL used for metadata / canonical links
NEXT_PUBLIC_SITE_URL=https://bd24news.vercel.app

# Comma-separated list of administrator emails allowed to sign in to the
# admin panel. Existing Firebase Authentication accounts only; public
# registration is disabled, so no new users can be created.
NEXT_PUBLIC_ADMIN_EMAILS=bd24news@tensi.org,riyadsarkar1243@gmail.com

# Optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
