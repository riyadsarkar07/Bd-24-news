rules_version = '2';

// BD24News Firestore Security Rules
// Reads are public so the Next.js server components can render via the JS SDK.
// Writes require an authenticated user whose email matches an allowed administrator.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['bd24news@tensi.org', 'riyadsarkar1243@gmail.com'];
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.author != null;
      allow update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow read: if true;
      allow create, update: if request.auth != null
        || (request.resource.data.email is string && request.resource.data.email.matches('.*@.*'));
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
