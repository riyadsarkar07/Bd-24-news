# =====================================================
# BD24News — Supabase configuration (Vercel environment)
# Copy these values from: Supabase Dashboard > Project Settings >
# API (Project URL + publishable key).
# =====================================================

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://pvqtsaiccfweearaltgo.supabase.co

# Supabase publishable (anon) key — never commit a service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Site URL used for metadata / canonical links
NEXT_PUBLIC_SITE_URL=https://bd24news.vercel.app

# Comma-separated list of administrator emails allowed to sign in to the
# admin panel. Existing Supabase Auth accounts only; public registration is
# disabled, so no new users can be created.
NEXT_PUBLIC_ADMIN_EMAILS=bd24news@tensi.org,riyadsarkar1243@gmail.com

# Optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
